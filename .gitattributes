# Left out of the archive Composer installs: what only developing the
# framework needs. The browser tests stay reachable by cloning the repository,
# which is how theme CI fetches them.
/.github export-ignore
/.gitattributes export-ignore
/.gitmodules export-ignore
/.husky export-ignore
/CLAUDE.md export-ignore
/commitlint.config.js export-ignore
/documentation export-ignore
/package.json export-ignore
/package-lock.json export-ignore
/phpmd.xml export-ignore
/phpstan-baseline.neon export-ignore
/phpstan-bootstrap.php export-ignore
/phpstan-ignore-rules.neon export-ignore
/phpstan.neon export-ignore
/phpunit.xml.dist export-ignore
/pint.json export-ignore
/rector.php export-ignore
/testbench.yaml export-ignore
/tests export-ignore
