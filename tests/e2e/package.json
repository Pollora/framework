{
  "name": "pollora-framework-e2e",
  "private": true,
  "description": "Browser tests run against a real Pollora site",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:unit": "node --test support/perf.test.ts",
    "budgets:update": "E2E_UPDATE_BUDGETS=1 playwright test query-budget",
    "perf:compare": "node bin/perf-compare.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@wordpress/e2e-test-utils-playwright": "3.3.0"
  }
}
