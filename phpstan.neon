includes:
    - vendor/pollora/harness/presets/phpstan/base.neon
    - vendor/pollora/harness/presets/phpstan/laravel.neon
    - phpstan-baseline.neon
    - phpstan-ignore-rules.neon

parameters:
    bootstrapFiles:
        - phpstan-bootstrap.php

    treatPhpDocTypesAsCertain: false

    paths:
        - src/

    level: 5